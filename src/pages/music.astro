---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

// Last.fm config. These are read at build time and inlined into the client
// script below. The API key is read-only and only ever sees public scrobble
// data, so it is fine to ship to the browser (it ends up in the page source of
// any "now playing" widget anyway). Build env vars
// (PUBLIC_LASTFM_USERNAME / PUBLIC_LASTFM_API_KEY) override these — see README.
// NB: use `||`, not `??`. CI passes these env vars through as *empty strings*
// when the repo variable/secret isn't set, and `??` wouldn't fall back on "".
const LASTFM_USERNAME = import.meta.env.PUBLIC_LASTFM_USERNAME || "NestorDHCP";
const LASTFM_API_KEY =
  import.meta.env.PUBLIC_LASTFM_API_KEY || "130e996340687500f9e282660628d30f";
---

<BaseLayout
  title="Music · Nelson Jeanrenaud"
  description="What Nelson Jeanrenaud has been listening to lately, from Last.fm."
>
  <SiteHeader />
  <span id="top"></span>

  <main class="wrap music">
    <section class="section music__head" aria-label="Music">
      <h1 class="music__title">Music</h1>
    </section>

    <!-- ─── Current / Last played ─── -->
    <section class="section music__now" aria-label="Now playing" aria-live="polite">
      <div class="np" id="np" data-state="loading">
        <!-- vinyl + meta are injected here by the script -->
        <div class="np__placeholder" aria-hidden="true">
          <div class="vinyl vinyl--lg">
            <div class="vinyl__spin">
              <div class="vinyl__art vinyl__art--empty"></div>
              <div class="vinyl__grooves"></div>
            </div>
            <div class="vinyl__hole"></div>
          </div>
        </div>
        <p class="music__quiet" id="np-quiet">Loading…</p>
      </div>
    </section>

    <!-- ─── Recently played shelf ─── -->
    <section class="section music__recent" aria-label="Recently played">
      <p class="kicker">Recently played</p>
      <ul class="shelf" id="shelf" aria-busy="true"></ul>
      <p class="music__quiet music__quiet--shelf" id="shelf-quiet" hidden></p>

      <!-- inspector panel: details for the clicked record (script-filled) -->
      <div class="detail" id="detail" aria-live="polite" hidden></div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script define:vars={{ LASTFM_USERNAME, LASTFM_API_KEY }}>
  const ENDPOINT = "https://ws.audioscrobbler.com/2.0/";
  // Last.fm serves this image when a release has no cover art.
  const PLACEHOLDER = "2a96cbd8b46e442fc41c2b86b821562f";

  const npEl = document.getElementById("np");
  const shelfEl = document.getElementById("shelf");
  const shelfQuiet = document.getElementById("shelf-quiet");
  const detailEl = document.getElementById("detail");

  /** Thin wrapper around the Last.fm REST API (JSON). */
  function api(params) {
    const q = new URLSearchParams({
      ...params,
      api_key: LASTFM_API_KEY,
      format: "json",
    });
    return fetch(`${ENDPOINT}?${q}`).then((r) => {
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.json();
    });
  }

  /** Pick the largest usable cover, or "" if none / placeholder only. */
  function coverUrl(images) {
    if (!Array.isArray(images)) return "";
    for (let i = images.length - 1; i >= 0; i--) {
      const url = images[i] && images[i]["#text"];
      if (url && !url.includes(PLACEHOLDER)) return url;
    }
    return "";
  }

  function relativeTime(unixSeconds) {
    if (!unixSeconds) return "";
    const diff = Date.now() - unixSeconds * 1000;
    const mins = Math.round(diff / 60000);
    if (mins < 1) return "just now";
    if (mins < 60) return `${mins} min ago`;
    const hours = Math.round(mins / 60);
    if (hours < 24) return `${hours} hr ago`;
    const days = Math.round(hours / 24);
    if (days < 7) return `${days} day${days === 1 ? "" : "s"} ago`;
    const weeks = Math.round(days / 7);
    return `${weeks} wk${weeks === 1 ? "" : "s"} ago`;
  }

  /** Build a vinyl record element for a track. */
  function vinyl(track, { large } = {}) {
    const art = coverUrl(track.image);

    const disc = document.createElement("div");
    disc.className = "vinyl" + (large ? " vinyl--lg" : "");

    const spin = document.createElement("div");
    spin.className = "vinyl__spin";

    const face = document.createElement("div");
    face.className = "vinyl__art" + (art ? "" : " vinyl__art--empty");
    if (art) face.style.backgroundImage = `url("${art}")`;

    const grooves = document.createElement("div");
    grooves.className = "vinyl__grooves";

    spin.append(face, grooves);

    const hole = document.createElement("div");
    hole.className = "vinyl__hole";

    disc.append(spin, hole);
    return disc;
  }

  function renderNowPlaying(track) {
    const playing =
      track["@attr"] && track["@attr"].nowplaying === "true";
    const title = (track.name || "").trim();
    const artist = (track.artist && track.artist["#text"] || "").trim();
    const album = (track.album && track.album["#text"] || "").trim();
    const when = track.date && track.date.uts ? Number(track.date.uts) : 0;

    npEl.setAttribute("data-state", playing ? "playing" : "idle");
    npEl.classList.toggle("is-playing", playing);
    npEl.replaceChildren();

    // The hero record is clickable too — but only for inspection. Selecting it
    // never changes this section's state, and the spin stays tied to nowplaying.
    const figure = document.createElement("button");
    figure.type = "button";
    figure.className = "np__vinyl";
    figure.setAttribute("aria-pressed", "false");
    figure.setAttribute(
      "aria-label",
      `Inspect ${title || "this track"}${artist ? " by " + artist : ""}`
    );
    figure.append(vinyl(track, { large: true }));
    const playedLabel = playing
      ? "Now playing"
      : when
        ? `Played ${relativeTime(when)}`
        : "Last played";
    figure.addEventListener("click", () =>
      selectVinyl(figure, track, { playedLabel })
    );

    const meta = document.createElement("div");
    meta.className = "np__meta";

    const status = document.createElement("p");
    status.className = "np__status";
    if (playing) {
      const dot = document.createElement("span");
      dot.className = "np__dot";
      dot.setAttribute("aria-hidden", "true");
      status.append(dot, document.createTextNode("Now playing"));
    } else {
      const rel = relativeTime(when);
      status.textContent = rel ? `Last played · ${rel}` : "Last played";
    }

    const h = document.createElement("p");
    h.className = "np__title";
    if (track.url) {
      const a = document.createElement("a");
      a.href = track.url;
      a.target = "_blank";
      a.rel = "noopener noreferrer";
      a.textContent = title || "Unknown track";
      h.append(a);
    } else {
      h.textContent = title || "Unknown track";
    }

    const sub = document.createElement("p");
    sub.className = "np__sub";
    sub.textContent = album ? `${artist} — ${album}` : artist;

    meta.append(status, h, sub);
    npEl.append(figure, meta);
  }

  function renderShelf(tracks) {
    shelfEl.replaceChildren();
    for (const track of tracks) {
      const title = (track.name || "").trim();
      const artist = (track.artist && track.artist["#text"] || "").trim();

      const when = track.date && track.date.uts ? Number(track.date.uts) : 0;
      const nowplaying =
        track["@attr"] && track["@attr"].nowplaying === "true";

      const li = document.createElement("li");
      li.className = "shelf__item";

      // A button, not a link: clicking inspects the record in the panel below
      // (the Last.fm link lives in the panel) rather than navigating away.
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "record";
      btn.setAttribute("aria-pressed", "false");
      btn.setAttribute(
        "aria-label",
        artist ? `Inspect ${title} by ${artist}` : `Inspect ${title}`
      );
      btn.append(vinyl(track));

      const cap = document.createElement("span");
      cap.className = "record__cap";
      const t = document.createElement("span");
      t.className = "record__title";
      t.textContent = title;
      const a = document.createElement("span");
      a.className = "record__artist";
      a.textContent = artist;
      cap.append(t, a);

      btn.append(cap);
      const playedLabel = nowplaying
        ? "Now playing"
        : when
          ? `Played ${relativeTime(when)}`
          : "Recently played";
      btn.addEventListener("click", () =>
        selectVinyl(btn, track, { playedLabel })
      );
      li.append(btn);
      shelfEl.append(li);
    }
    shelfEl.setAttribute("aria-busy", "false");
    updateShelfScroll();
  }

  /** Fade only the edge(s) that have off-screen records. */
  function updateShelfScroll() {
    const slack = shelfEl.scrollWidth - shelfEl.clientWidth;
    if (slack <= 4) {
      shelfEl.removeAttribute("data-scroll");
      return;
    }
    const x = shelfEl.scrollLeft;
    const atStart = x <= 4;
    const atEnd = x >= slack - 4;
    shelfEl.setAttribute(
      "data-scroll",
      atStart ? "start" : atEnd ? "end" : "middle"
    );
  }
  shelfEl.addEventListener("scroll", updateShelfScroll, { passive: true });
  window.addEventListener("resize", updateShelfScroll, { passive: true });

  /* ─── Inspecting a record (details panel) ──────────────────────────── */

  let selectedBtn = null;
  let seltoken = 0; // guards against out-of-order detail responses

  /** Toggle the chosen vinyl's selected state and (re)fill the panel. */
  function selectVinyl(btn, track, opts) {
    if (selectedBtn === btn) {
      deselect();
      return;
    }
    if (selectedBtn) {
      selectedBtn.classList.remove("is-selected");
      selectedBtn.setAttribute("aria-pressed", "false");
    }
    selectedBtn = btn;
    btn.classList.add("is-selected");
    btn.setAttribute("aria-pressed", "true");

    const refs = renderDetailBase(track, opts);
    detailEl.scrollIntoView({ block: "nearest" });
    enrichDetail(track, refs, ++seltoken);
  }

  function deselect() {
    if (selectedBtn) {
      selectedBtn.classList.remove("is-selected");
      selectedBtn.setAttribute("aria-pressed", "false");
      selectedBtn = null;
    }
    seltoken++; // invalidate any in-flight fetch
    detailEl.hidden = true;
    detailEl.replaceChildren();
  }

  /** Render the always-available info (straight from the scrobble). */
  function renderDetailBase(track, { playedLabel }) {
    const title = (track.name || "").trim();
    const artist = (track.artist && track.artist["#text"] || "").trim();
    const album = (track.album && track.album["#text"] || "").trim();
    const art = coverUrl(track.image);

    detailEl.replaceChildren();
    detailEl.hidden = false;

    const close = document.createElement("button");
    close.type = "button";
    close.className = "detail__close";
    close.setAttribute("aria-label", "Close details");
    close.textContent = "✕";
    close.addEventListener("click", deselect);

    const sleeve = document.createElement("div");
    sleeve.className = "detail__sleeve" + (art ? "" : " detail__sleeve--empty");
    if (art) sleeve.style.backgroundImage = `url("${art}")`;
    else sleeve.textContent = "♪";

    const body = document.createElement("div");
    body.className = "detail__body";

    const status = document.createElement("p");
    status.className = "detail__status";
    status.textContent = playedLabel || "";

    const h = document.createElement("p");
    h.className = "detail__title";
    h.textContent = title || "Unknown track";

    const sub = document.createElement("p");
    sub.className = "detail__artist";
    sub.textContent = album ? `${artist} — ${album}` : artist;

    const summary = document.createElement("p");
    summary.className = "detail__summary";
    summary.hidden = true;

    const tags = document.createElement("ul");
    tags.className = "detail__tags";
    tags.hidden = true;

    const links = document.createElement("p");
    links.className = "detail__links";
    links.hidden = true;

    const note = document.createElement("p");
    note.className = "detail__note music__quiet";
    note.hidden = true;

    body.append(status, h, sub, summary, tags, links, note);
    detailEl.append(close, sleeve, body);
    return { title, artist, album, summary, tags, links, note, scrobbleUrl: track.url || "" };
  }

  /** HTML wiki blurbs → a short, clean, plain-text sentence or two. */
  function cleanWiki(html) {
    if (!html) return "";
    const text =
      new DOMParser().parseFromString(html, "text/html").body.textContent || "";
    let t = text.replace(/\s*Read more on Last\.fm.*$/is, "").trim();
    if (!t) return "";
    const LIMIT = 240;
    if (t.length > LIMIT) {
      t = t.slice(0, LIMIT);
      const dot = t.lastIndexOf(". ");
      if (dot > 120) t = t.slice(0, dot + 1);
      else t = t.replace(/[\s,;:]+\S*$/, "") + "…";
    }
    return t;
  }

  /** Up to five tag names from a track/album/artist getInfo payload. */
  function pickTags(info) {
    if (!info) return null;
    const raw =
      (info.toptags && info.toptags.tag) || (info.tags && info.tags.tag);
    if (!raw) return null;
    const arr = Array.isArray(raw) ? raw : [raw];
    const names = arr
      .map((x) => x && (x.name || "").trim())
      .filter(Boolean)
      .slice(0, 5);
    return names.length ? names : null;
  }

  function renderLinks(el, items) {
    el.replaceChildren();
    items
      .filter((it) => it.url)
      .forEach((it, i) => {
        if (i > 0) {
          const sep = document.createElement("span");
          sep.className = "detail__sep";
          sep.setAttribute("aria-hidden", "true");
          sep.textContent = "·";
          el.append(sep);
        }
        const a = document.createElement("a");
        a.href = it.url;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = `${it.label} ↗`;
        el.append(a);
      });
    el.hidden = el.childElementCount === 0;
  }

  /** Fetch track / album / artist details and fold them into the panel. */
  async function enrichDetail(track, refs, token) {
    const { artist, album, title } = refs;
    if (!artist || !title) return;

    let trackInfo = null,
      albumInfo = null,
      artistInfo = null,
      fails = 0,
      total = 0;

    const calls = [];
    total++;
    calls.push(
      api({ method: "track.getInfo", artist, track: title, username: LASTFM_USERNAME })
        .then((d) => (trackInfo = d && d.track))
        .catch(() => fails++)
    );
    if (album) {
      total++;
      calls.push(
        api({ method: "album.getInfo", artist, album })
          .then((d) => (albumInfo = d && d.album))
          .catch(() => fails++)
      );
    }
    total++;
    calls.push(
      api({ method: "artist.getInfo", artist })
        .then((d) => (artistInfo = d && d.artist))
        .catch(() => fails++)
    );

    await Promise.all(calls);
    if (token !== seltoken) return; // a newer selection won

    // Links — fall back to the scrobble's own track URL if getInfo failed.
    const trackUrl = (trackInfo && trackInfo.url) || refs.scrobbleUrl;
    const albumUrl =
      (albumInfo && albumInfo.url) ||
      (trackInfo && trackInfo.album && trackInfo.album.url) ||
      "";
    const artistUrl = (artistInfo && artistInfo.url) || "";
    renderLinks(refs.links, [
      { label: "Track", url: trackUrl },
      ...(album ? [{ label: "Album", url: albumUrl }] : []),
      { label: "Artist", url: artistUrl },
    ]);

    // A short blurb — prefer the track wiki, else the artist bio.
    const summary =
      cleanWiki(trackInfo && trackInfo.wiki && trackInfo.wiki.summary) ||
      cleanWiki(artistInfo && artistInfo.bio && artistInfo.bio.summary);
    if (summary) {
      refs.summary.textContent = summary;
      refs.summary.hidden = false;
    }

    // Tags — track first, then album, then artist.
    const tags = pickTags(trackInfo) || pickTags(albumInfo) || pickTags(artistInfo);
    if (tags) {
      refs.tags.replaceChildren();
      for (const name of tags) {
        const li = document.createElement("li");
        li.className = "detail__tag";
        li.textContent = name;
        refs.tags.append(li);
      }
      refs.tags.hidden = false;
    }

    // Quiet failure note only if every call failed (base info still shows).
    if (fails >= total) {
      refs.note.textContent = "Couldn't load details.";
      refs.note.hidden = false;
    }
  }

  function quietNow(message) {
    npEl.setAttribute("data-state", "empty");
    npEl.classList.remove("is-playing");
    npEl.replaceChildren();
    const ph = document.createElement("div");
    ph.className = "np__vinyl";
    ph.append(vinyl({}, { large: true }));
    const p = document.createElement("p");
    p.className = "music__quiet";
    p.textContent = message;
    npEl.append(ph, p);
  }

  function quietShelf(message) {
    shelfEl.setAttribute("aria-busy", "false");
    shelfEl.replaceChildren();
    shelfQuiet.textContent = message;
    shelfQuiet.hidden = false;
  }

  async function load() {
    if (!LASTFM_USERNAME || !LASTFM_API_KEY) {
      quietNow("Nothing to show right now.");
      quietShelf("");
      return;
    }

    try {
      const data = await api({
        method: "user.getrecenttracks",
        user: LASTFM_USERNAME,
        limit: "12",
      });
      const tracks =
        data && data.recenttracks && Array.isArray(data.recenttracks.track)
          ? data.recenttracks.track
          : [];

      if (!tracks.length) {
        quietNow("Nothing to show right now.");
        quietShelf("");
        return;
      }

      renderNowPlaying(tracks[0]);
      const rest = tracks.slice(1, 11);
      if (rest.length) renderShelf(rest);
      else quietShelf("");
    } catch (err) {
      quietNow("Couldn't reach Last.fm just now.");
      quietShelf("");
    }
  }

  load();
</script>
