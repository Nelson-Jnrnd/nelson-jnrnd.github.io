---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { cv } from "../data/profile";
import { Image } from "astro:assets";
import atlasShot from "../images/dinosaurs/exploration-map.png";
import qualifyingDelta from "../images/projects/australia-2024-qualifying-delta.png";
import "../styles/projects.css";

const email = "contact@nelson-j.ch";
const github = "https://github.com/nelson-jnrnd";
const linkedin = "https://www.linkedin.com/in/nelson-jeanrenaud-b32374222";

---

<BaseLayout>
  <SiteHeader />
  <span id="top"></span>

  <main class="wrap">
    <!-- ───────────────── Intro ───────────────── -->
    <section class="section intro" aria-label="Introduction">
      <div class="intro__top">
        <div class="intro__id">
          <h1>Nelson Jeanrenaud</h1>
          <p class="intro__role">
            software engineer
            <span class="sep">·</span>
            switzerland
          </p>
          <p class="intro__status" aria-label="Availability">Open to new opportunities</p>
        </div>
      </div>

      <div class="intro__body">
        <div class="intro__copy">
          <p class="intro__statement">
            I design and build .NET software for industrial systems, from operator interfaces and PLC integration to digital twins.
          </p>
          <p class="intro__availability">
            Looking for a .NET software engineering role in industrial automation in Switzerland.
          </p>
          <div class="intro__actions" aria-label="Explore my work">
            <a href="#projects">View projects</a>
            <a href={cv} download>Download CV (PDF)</a>
          </div>
        </div>
        <img
          class="portrait"
          src="/images/portrait.jpg"
          alt="Nelson Jeanrenaud"
          width="640"
          height="800"
          loading="eager"
        />
      </div>
    </section>

    <!-- ───────────────── Work ───────────────── -->
    <section class="section" id="work" aria-label="Work">
      <p class="kicker">Work</p>
      <h2>What I'm doing now</h2>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">HEIG-VD</span> · Institute of Industrial Automation · Yverdon-les-Bains</span>
          <span class="entry__date">Apr 2025 – Present</span>
        </div>
        <h3 class="entry__title">R&amp;D Collaborator</h3>
        <p class="entry__desc">
          Designing and building .NET control software for an automated hydroponic lettuce
          installation. My work includes requirements and modelling, a Blazor web HMI,
          integration with PLCs, cameras and AI models, a DLL plugin framework, and a real-time
          3D digital twin for testing machine behaviour.
        </p>
        <p class="entry__desc"><a href="/work/heig-vd">More about my work at HEIG-VD</a></p>
      </div>

      <h2 style="margin-top: 2.5rem;">My past experiences</h2>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">Abraxas Informatik AG</span> · Morges</span>
          <span class="entry__date">Aug 2023 – Oct 2024</span>
        </div>
        <h3 class="entry__title">Software developer · Part-time</h3>
        <p class="entry__desc">
          Maintained and extended CARI, a Java application used by Swiss road traffic offices
          (bureau des autos). Investigated defects, reviewed code, and refactored an established
          application while preserving its existing behaviour.
        </p>
      </div>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">HEIG-VD</span> · Institute of Information &amp; Communication Technology · Yverdon-les-Bains</span>
          <span class="entry__date">Aug 2023 – Oct 2024</span>
        </div>
        <h3 class="entry__title">Teaching assistant — Object-Oriented Programming and Cloud Computing · Part-time</h3>
        <p class="entry__desc">
          Supported students in the bachelor courses taught by
          <a class="ref" href="https://people.hes-so.ch/fr/profile/2002425133-marcel-graf" target="_blank" rel="noopener noreferrer">Prof. Marcel Graf</a>,
          covering Java and object-oriented modelling, alongside cloud topics including
          AWS, GCP, Docker, Kubernetes, Terraform, and Ansible.
        </p>
      </div>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">Swiss Armed Forces</span> · Maintenance School 43 · Thun</span>
          <span class="entry__date">Jul 2024 – Nov 2024</span>
        </div>
        <h3 class="entry__title">Communication diagnostician</h3>
        <p class="entry__desc">
          Basic military training and maintenance, plus diagnosis of military radio communication
          equipment.
        </p>
      </div>
    </section>

    <!-- ───────────────── Education ───────────────── -->
    <section class="section" id="education" aria-label="Education">
      <p class="kicker">Education</p>
      <h2>Where I studied</h2>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">HEIG-VD</span> · Yverdon-les-Bains</span>
          <span class="entry__date">Class of 2023</span>
        </div>
        <h3 class="entry__title">Bachelor of Science in Computer Science</h3>
        <p class="entry__desc">
          Bachelor's degree, with a thesis on machine learning for pit-stop decision
          modelling in Formula 1 (see Projects).
        </p>
      </div>
    </section>

    <!-- ───────────────── Projects ───────────────── -->
    <section class="section" id="projects" aria-label="Personal and academic projects">
      <p class="kicker">Projects</p>
      <h2>Personal and academic projects</h2>

      <article class="project">
        <div class="project__head">
          <h3><a href="/dinosaurs">Mesozoic Dinosaur Atlas</a></h3>
          <span class="project__meta">Personal project</span>
        </div>
        <p class="project__desc">
          I built an interactive atlas that connects dinosaur fossil discoveries with a timeline
          and reconstructed continents. Explore individual finds, browse the dinosaur family tree,
          or play the daily Dinordle guessing game.
        </p>
        <figure class="project__figure">
          <a href="/dinosaurs" aria-label="See the Mesozoic Dinosaur Atlas project">
            <Image src={atlasShot} alt="Dinosaur fossil discoveries plotted on reconstructed continents, with a timeline set to about 72 million years ago." width={960} loading="lazy" />
          </a>
          <figcaption>Browse fossil discoveries by location and time.</figcaption>
        </figure>
        <div class="project__actions">
          <a href="/dinosaurs">See the project</a>
          <a href="https://paleomap.nelson-j.ch/" target="_blank" rel="noopener noreferrer">Explore the live atlas</a>
        </div>
      </article>

      <article class="project" id="formula-one-analysis">
        <div class="project__head">
          <h3><a href="/projects/formula-one-analysis">Formula 1 data analysis</a></h3>
          <span class="project__meta">Python · 2021 – 2024</span>
        </div>
        <p class="project__desc">
          I ran a race-analysis blog and built Python tooling to turn session and telemetry data
          into performance charts and reports. One example compares Ocon and Gasly's qualifying
          laps at the 2024 Australian Grand Prix to examine where their lap times diverged.
        </p>
        <figure class="project__figure">
          <a href="/projects/formula-one-analysis" aria-label="Read the Australia 2024 qualifying analysis sample">
            <Image src={qualifyingDelta} alt="Archived chart comparing the time difference between Ocon and Gasly over a qualifying lap at the 2024 Australian Grand Prix." width={960} loading="lazy" />
          </a>
          <figcaption>A chart from my March 2024 qualifying analysis.</figcaption>
        </figure>
        <div class="project__actions">
          <a href="/projects/formula-one-analysis">Read my qualifying analysis</a>
          <a href="/blog/">Read my Formula 1 articles</a>
        </div>
      </article>

      <article class="project" id="pit-stop-modelling">
        <div class="project__head">
          <h3><a href="/projects/pit-stop-modelling">Pit-stop decision modelling</a></h3>
          <span class="project__meta">B.Sc. thesis · 2023</span>
        </div>
        <p class="project__desc">
          For my bachelor's thesis, I collected and prepared Formula 1 race data, then compared
          random forests, neural networks and recurrent neural networks for predicting pit stops
          and tyre choices. I examined what drove their predictions and the limitations of
          learning from historical team decisions.
        </p>
        <figure class="project__figure">
          <a href="/projects/pit-stop-modelling" aria-label="Read the pit-stop decision modelling thesis summary">
            <img src="/projects/pit-stop-probabilities-stroll-2023.svg" alt="Thesis chart showing lap-by-lap predicted pit-stop probabilities for Lance Stroll in Spain 2023, with actual pit stops marked by red vertical lines." width="1067" height="480" loading="lazy" />
          </a>
          <figcaption>Predicted pit-stop probabilities compared with actual stops. A high predicted probability does not mean it was the best time to pit.</figcaption>
        </figure>
        <div class="project__actions">
          <a href="/projects/pit-stop-modelling">Read the thesis summary</a>
          <a href="/projects/pit-stop-modelling/report/">Read my intermediate report (French PDF)</a>
          <a href="/projects/pit-stop-modelling/defence/">View my thesis defence slides</a>
        </div>
        <p class="project__note">My thesis was graded 5.6/6. The linked PDF is my intermediate report.</p>
      </article>
    </section>

    <!-- ───────────────── Toolkit ───────────────── -->
    <section class="section" id="toolkit" aria-labelledby="toolkit-title">
      <p class="kicker">Tools</p>
      <h2 id="toolkit-title">Technologies I work with</h2>
      <div class="tk">
        <div class="tk__row">
          <span class="tk__label">Languages</span>
          <span class="tk__items">
            <strong class="tk__focus">C#</strong>,
            Java,
            Python,
            SQL,
            JavaScript
          </span>
        </div>
        <div class="tk__row">
          <span class="tk__label">Frameworks</span>
          <span class="tk__items">
            <strong class="tk__focus">ASP.NET Core</strong>,
            <strong class="tk__focus">Blazor</strong>,
            <strong class="tk__focus">WPF</strong>,
            AngularJS,
            Spring
          </span>
        </div>
        <div class="tk__row">
          <span class="tk__label">Infrastructure</span>
          <span class="tk__items">
            Git,
            Docker,
            Kubernetes,
            GCP,
            AWS,
            Terraform,
            Ansible,
            CI/CD
          </span>
        </div>
        <div class="tk__row">
          <span class="tk__label">Data</span>
          <span class="tk__items">
            Pandas,
            NumPy,
            scikit-learn,
            TensorFlow
          </span>
        </div>
      </div>
    </section>

    <!-- ───────────────── Interests ───────────────── -->
    <section class="section" id="interests" aria-label="Interests">
      <p class="kicker">Interests</p>
      <h2>What I do outside of work</h2>
      <p>
        Usually hanging out in the sun, playing tennis, watching racecars, and listening to music.
      </p>
      <div class="tags" aria-label="Interests">
        <span class="tag">Motorsport</span>
        <span class="tag">Tennis</span>
        <span class="tag">Board games</span>
        <span class="tag">Magic: The Gathering</span>
        <span class="tag">Dungeons &amp; Dragons</span>
        <span class="tag">Dinosaurs</span>
        <a class="tag tag--link" href="/music">Music ↗</a>
        <span class="tag">Dogs</span>
      </div>
    </section>

    <!-- ───────────────── Contact ───────────────── -->
    <section class="section" id="contact" aria-label="Contact">
      <p class="kicker">Contact</p>
      <h2>How to reach me</h2>
      <div class="links">
        <div class="link-row">
          <span class="link-row__key">Email</span>
          <span class="link-row__val"><a href={`mailto:${email}`}>{email}</a></span>
        </div>
        <div class="link-row">
          <span class="link-row__key">GitHub</span>
          <span class="link-row__val"><a href={github} target="_blank" rel="noopener noreferrer">github.com/nelson-jnrnd</a></span>
        </div>
        <div class="link-row">
          <span class="link-row__key">LinkedIn</span>
          <span class="link-row__val"><a href={linkedin} target="_blank" rel="noopener noreferrer">in/nelson-jeanrenaud</a></span>
        </div>
        <div class="link-row">
          <span class="link-row__key">CV</span>
          <span class="link-row__val"><a href={cv} download>Download (PDF)</a></span>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
