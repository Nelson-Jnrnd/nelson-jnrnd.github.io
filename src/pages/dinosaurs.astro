---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { Image, getImage } from "astro:assets";
import mapShot from "../images/dinosaurs/exploration-map.png";
import findShot from "../images/dinosaurs/occurrence-panel.png";
import treeShot from "../images/dinosaurs/taxonomy-browser.png";
import puzzleShot from "../images/dinosaurs/dinordle-puzzle.png";

const appUrl = "https://paleomap.nelson-j.ch/";

// Larger renditions for the click-to-enlarge lightbox — the carousel
// itself only ever loads the small (960px) version.
const [mapFull, findFull, treeFull, puzzleFull] = await Promise.all(
  [mapShot, findShot, treeShot, puzzleShot].map((src) =>
    getImage({ src, width: 1800, format: "webp" })
  )
);
---

<BaseLayout
  title="Dinosaurs · Nelson Jeanrenaud"
  description="A personal project: a map showing where and when dinosaur fossils have actually been found, from about 250 million years ago to the end of the age of dinosaurs."
>
  <SiteHeader />
  <span id="top"></span>

  <main class="wrap dino">
    <!-- ───────────────── Head ───────────────── -->
    <section class="section dino__head" aria-label="Dinosaurs">
      <p class="kicker">Side project</p>
      <h1 class="dino__title">A map of the dinosaurs</h1>
      <p class="lead dino__tagline">
        Where and when dinosaur fossils have actually been dug up, across the
        roughly 180 million years dinosaurs walked the Earth.
      </p>
    </section>

    <!-- ───────────────── Screenshots ───────────────── -->
    <section class="section dino__carousel-section" aria-label="Screenshots of the app">
      <div class="dino__carousel">
        <div class="dino__track" id="dino-track" tabindex="0" aria-label="paleo-map screenshots, use the arrow keys to browse">
          <figure class="dino__slide">
            <button class="dino__zoom" type="button" data-full={mapFull.src} aria-label="View this screenshot full-size">
              <Image
                src={mapShot}
                alt="The map screen: an old world map with colourful dots marking dinosaur fossil discoveries, and a timeline slider running along the top."
                width={960}
                loading="eager"
              />
              <span class="dino__zoom-hint" aria-hidden="true">⤢</span>
            </button>
            <figcaption class="dino__caption">
              Slide through time and the map redraws the continents to
              match. This one's set to about 72 million years ago, not long
              before the asteroid.
            </figcaption>
          </figure>
          <figure class="dino__slide">
            <button class="dino__zoom" type="button" data-full={findFull.src} aria-label="View this screenshot full-size">
              <Image
                src={findShot}
                alt="A detail card open for a single fossil discovery, showing what it is, roughly when it lived, and where the information came from."
                width={960}
              />
              <span class="dino__zoom-hint" aria-hidden="true">⤢</span>
            </button>
            <figcaption class="dino__caption">
              Click any dot to see what it is, roughly when it lived, and
              where that information comes from.
            </figcaption>
          </figure>
          <figure class="dino__slide">
            <button class="dino__zoom" type="button" data-full={treeFull.src} aria-label="View this screenshot full-size">
              <Image
                src={treeShot}
                alt="A browsable dinosaur family tree, from broad groups down to individual species."
                width={960}
              />
              <span class="dino__zoom-hint" aria-hidden="true">⤢</span>
            </button>
            <figcaption class="dino__caption">
              A family tree you can browse, from big groups like armoured
              dinosaurs down to individual species.
            </figcaption>
          </figure>
          <figure class="dino__slide">
            <button class="dino__zoom" type="button" data-full={puzzleFull.src} aria-label="View this screenshot full-size">
              <Image
                src={puzzleShot}
                alt="A daily dinosaur-guessing puzzle called Dinordle, styled after the word game Wordle."
                width={960}
              />
              <span class="dino__zoom-hint" aria-hidden="true">⤢</span>
            </button>
            <figcaption class="dino__caption">
              There's also a daily guessing game called Dinordle. Like
              Wordle, but each guess narrows down a dinosaur instead of a
              word.
            </figcaption>
          </figure>
        </div>

        <div class="dino__controls">
          <button class="dino__nav dino__nav--prev" type="button" aria-label="Previous screenshot">‹ Prev</button>
          <div class="dino__dots" role="tablist" aria-label="Choose a screenshot">
            <button class="dino__dot" type="button" aria-current="true" aria-label="Screenshot 1 of 4"></button>
            <button class="dino__dot" type="button" aria-current="false" aria-label="Screenshot 2 of 4"></button>
            <button class="dino__dot" type="button" aria-current="false" aria-label="Screenshot 3 of 4"></button>
            <button class="dino__dot" type="button" aria-current="false" aria-label="Screenshot 4 of 4"></button>
          </div>
          <button class="dino__nav dino__nav--next" type="button" aria-label="Next screenshot">Next ›</button>
        </div>
      </div>
    </section>

    <!-- ───────────────── Story ───────────────── -->
    <section class="section dino__body">
      <p>
        I got curious about dinosaurs again a while back and wanted to know
        where they actually lived. Turns out that's a hard question, because
        the continents were in completely different places back then. They
        were still drifting apart while dinosaurs were around, so a
        present-day map is the wrong map.
      </p>
      <p>
        So I built one, as a hobby project. It redraws the continents the way
        scientists think they looked at any point from about 250 million
        years ago up to the asteroid impact, with real fossil discoveries
        plotted on top. Drag the slider and both move together: the shape of
        the land, and the dots showing where dinosaurs have actually been
        found.
      </p>
      <p>
        A dot marks a place a fossil was actually dug up, not a guess at
        everywhere that animal might have roamed. Those are different things
        and easy to mix up. When something isn't known for sure, the map says
        so instead of hiding it.
      </p>
    </section>

    <!-- ───────────────── CTA ───────────────── -->
    <section class="section dino__cta">
      <a class="dino__link" href={appUrl} target="_blank" rel="noopener noreferrer">
        Explore the map ↗
      </a>
    </section>
  </main>

  <!-- Full-size view for a tapped/clicked screenshot -->
  <div class="dino__lightbox" id="dino-lightbox" hidden>
    <button class="dino__lightbox-close" id="dino-lightbox-close" type="button" aria-label="Close">✕</button>
    <img class="dino__lightbox-img" id="dino-lightbox-img" src="" alt="" />
  </div>

  <SiteFooter />
</BaseLayout>

<script>
  // A single-image-at-a-time carousel for the screenshots: prev/next
  // buttons and dots drive a native scroll-snap track, so it also just
  // works with touch swipes and trackpad scrolling.
  const track = document.getElementById("dino-track");
  const carousel = track?.closest(".dino__carousel");
  if (track && carousel) {
    const slides = Array.from(track.children);
    const dots = Array.from(carousel.querySelectorAll(".dino__dot"));
    const prevBtn = carousel.querySelector(".dino__nav--prev");
    const nextBtn = carousel.querySelector(".dino__nav--next");

    const closestIndex = () => {
      const trackLeft = track.getBoundingClientRect().left;
      let closest = 0;
      let smallestGap = Infinity;
      slides.forEach((slide, i) => {
        const gap = Math.abs(slide.getBoundingClientRect().left - trackLeft);
        if (gap < smallestGap) {
          smallestGap = gap;
          closest = i;
        }
      });
      return closest;
    };

    const goTo = (index) => {
      const clamped = Math.max(0, Math.min(slides.length - 1, index));
      slides[clamped].scrollIntoView({
        behavior: "smooth",
        block: "nearest",
        inline: "start",
      });
    };

    const sync = () => {
      const active = closestIndex();
      dots.forEach((dot, i) =>
        dot.setAttribute("aria-current", String(i === active))
      );
      if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = active === 0;
      if (nextBtn instanceof HTMLButtonElement)
        nextBtn.disabled = active === slides.length - 1;
    };

    prevBtn?.addEventListener("click", () => goTo(closestIndex() - 1));
    nextBtn?.addEventListener("click", () => goTo(closestIndex() + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        goTo(closestIndex() + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        goTo(closestIndex() - 1);
      }
    });

    let scrollTimer;
    track.addEventListener(
      "scroll",
      () => {
        clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(sync, 100);
      },
      { passive: true }
    );
    window.addEventListener("resize", sync, { passive: true });

    sync();
  }

  // Click/tap a screenshot to view it full-size in an overlay.
  const lightbox = document.getElementById("dino-lightbox");
  const lightboxImg = document.getElementById("dino-lightbox-img");
  const lightboxClose = document.getElementById("dino-lightbox-close");
  if (lightbox instanceof HTMLElement && lightboxImg instanceof HTMLImageElement) {
    let lastFocused = null;

    const openLightbox = (button) => {
      const full = button.dataset.full;
      const img = button.querySelector("img");
      if (!full || !img) return;
      lightboxImg.src = full;
      lightboxImg.alt = img.alt;
      lastFocused = document.activeElement;
      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
      lightboxClose?.focus();
    };

    const closeLightbox = () => {
      if (lightbox.hidden) return;
      lightbox.hidden = true;
      lightboxImg.removeAttribute("src");
      document.body.style.overflow = "";
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    };

    document.querySelectorAll(".dino__zoom").forEach((btn) => {
      btn.addEventListener("click", () => openLightbox(btn));
    });
    lightboxClose?.addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeLightbox();
    });
  }
</script>
