---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { Image } from "astro:assets";
import atlasShot from "../images/dinosaurs/exploration-map.png";
import qualifyingDelta from "../images/projects/australia-2024-qualifying-delta.png";
import "../styles/projects.css";

const email = "nelsonjeanrenaud@gmail.com";
const github = "https://github.com/nelson-jnrnd";
const linkedin = "https://www.linkedin.com/in/nelson-jeanrenaud-b32374222";
const cv = "/cv/nelson-jeanrenaud-cv.pdf";

/* Reference links (Wikipedia) all share one look — see `.ref` in global.css.
   Links that point at something I made or run stay gold. */
const w = (slug: string) => `https://en.wikipedia.org/wiki/${slug}`;
---

<BaseLayout>
  <SiteHeader />
  <span id="top"></span>

  <!-- ───────────── Availability banner ───────────── -->
  <aside class="openbar" aria-label="Availability">
    <p class="openbar__inner wrap">Open to work</p>
  </aside>

  <main class="wrap">
    <!-- ───────────────── Intro ───────────────── -->
    <section class="section intro" aria-label="Introduction">
      <div class="intro__top">
        <div class="intro__id">
          <h1>Nelson Jeanrenaud</h1>
          <p class="intro__role">
            <a class="ref" href={w("Software_engineering")} target="_blank" rel="noopener noreferrer">software engineer</a>
            <span class="sep">·</span>
            <a class="ref" href={w("Switzerland")} target="_blank" rel="noopener noreferrer">switzerland</a>
          </p>
        </div>
        <img
          class="portrait"
          src="/images/portrait.jpg"
          alt="Nelson Jeanrenaud"
          width="640"
          height="800"
          loading="eager"
        />
      </div>

      <div class="intro__body">
        <p>
          I used to write code. Now I watch a robot do it.
        </p>
        <p>
          Looking for a .NET / Industrial automation Software engineer role in Switzerland
        </p>
      </div>
    </section>

    <!-- ───────────────── Work ───────────────── -->
    <section class="section" id="work" aria-label="Work">
      <p class="kicker">Work</p>
      <h2>What I'm doing now</h2>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">HEIG-VD</span> · Institute of Industrial Automation · Yverdon-les-Bains</span>
          <span class="entry__date">Apr 2025 – Present</span>
        </div>
        <h3 class="entry__title">Software architect &amp; full-stack developer</h3>
        <p class="entry__desc">
          Architecting and building, in collaboration with
          <a class="ref" href="https://www.innosuisse.ch/" target="_blank" rel="noopener noreferrer">Innosuisse</a>
          and our industrial partner
          <a class="ref" href="https://www.techponics.ag/" target="_blank" rel="noopener noreferrer">Techponics</a>,
          the control software for an AI-optimized hydroponic lettuce installation at HEIG-VD's
          Institute of Industrial Automation. I work closely with automation engineers on the PLC
          code, interfacing with it over ADS communication. The project also includes a digital twin that runs thousands of
          machine cycles in a virtual environment to test and validate behaviour before it ever
          touches the real hardware. The stack:
          <a class="ref" href={w("C_Sharp_(programming_language)")} target="_blank" rel="noopener noreferrer">C#</a> →
          <a class="ref" href={w("ASP.NET_Core")} target="_blank" rel="noopener noreferrer">ASP.NET Core</a> →
          <a class="ref" href={w("Blazor")} target="_blank" rel="noopener noreferrer">Blazor</a> +
          <a class="ref" href={w("Windows_Presentation_Foundation")} target="_blank" rel="noopener noreferrer">WPF</a>.
        </p>
      </div>

      <h2 style="margin-top: 2.5rem;">My past experiences</h2>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">Abraxas Informatik AG</span> · Morges</span>
          <span class="entry__date">Aug 2023 – Oct 2024</span>
        </div>
        <h3 class="entry__title">Software developer</h3>
        <p class="entry__desc">
          Maintained and extended CARI, a large
          <a class="ref" href={w("Java_(programming_language)")} target="_blank" rel="noopener noreferrer">Java</a>
          application used by Swiss road traffic offices (bureau des autos).
          Mostly legacy code: debugging, reviewing, and refactoring a long-lived codebase without
          breaking what already works.
        </p>
      </div>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">HEIG-VD</span> · Institute of Information &amp; Communication Technology · Yverdon-les-Bains</span>
          <span class="entry__date">Aug 2023 – Oct 2024</span>
        </div>
        <h3 class="entry__title">Assistant to Prof. <a class="ref" href="https://people.hes-so.ch/fr/profile/2002425133-marcel-graf" target="_blank" rel="noopener noreferrer">Marcel Graf</a></h3>
        <p class="entry__desc">
          Assisted both the
          <a class="ref" href={w("Object-oriented_programming")} target="_blank" rel="noopener noreferrer">OOP (object-oriented programming)</a>
          and Cloud Computing bachelor courses, helping students with object-oriented modelling —
          structuring code as objects that bundle data and behaviour — in
          <a class="ref" href={w("Java_(programming_language)")} target="_blank" rel="noopener noreferrer">Java</a>, and cloud topics
          (<a class="ref" href={w("Amazon_Web_Services")} target="_blank" rel="noopener noreferrer">AWS</a>/<a class="ref" href={w("Google_Cloud_Platform")} target="_blank" rel="noopener noreferrer">GCP</a>,
          <a class="ref" href={w("Docker_(software)")} target="_blank" rel="noopener noreferrer">Docker</a>,
          <a class="ref" href={w("Kubernetes")} target="_blank" rel="noopener noreferrer">Kubernetes</a>,
          <a class="ref" href={w("Terraform_(software)")} target="_blank" rel="noopener noreferrer">Terraform</a> and
          <a class="ref" href={w("Ansible_(software)")} target="_blank" rel="noopener noreferrer">Ansible</a>).
        </p>
      </div>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">Swiss Armed Forces</span> · Maintenance School 43 · Thun</span>
          <span class="entry__date">Jul 2024 – Nov 2024</span>
        </div>
        <h3 class="entry__title">Communication diagnostician</h3>
        <p class="entry__desc">
          Basic military training and maintenance, plus diagnosis of military radio communication
          equipment.
        </p>
      </div>
    </section>

    <!-- ───────────────── Education ───────────────── -->
    <section class="section" id="education" aria-label="Education">
      <p class="kicker">Education</p>
      <h2>Where I studied</h2>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">HEIG-VD</span> · Yverdon-les-Bains</span>
          <span class="entry__date">Class of 2023</span>
        </div>
        <h3 class="entry__title">Bachelor of Science in Computer Science</h3>
        <p class="entry__desc">
          Bachelor's degree, with a thesis on machine learning for pit-stop decision
          modelling in <a class="ref" href={w("Formula_One")} target="_blank" rel="noopener noreferrer">Formula 1</a> (see Projects).
        </p>
      </div>
    </section>

    <!-- ───────────────── Projects ───────────────── -->
    <section class="section" id="projects" aria-label="Personal and academic projects">
      <p class="kicker">Projects</p>
      <h2>Personal and academic projects</h2>

      <article class="project">
        <div class="project__head">
          <h3><a href="/dinosaurs">Mesozoic Dinosaur Atlas</a></h3>
          <span class="project__meta">Personal project</span>
        </div>
        <p class="project__desc">
          I built an interactive atlas that connects dinosaur fossil discoveries with a timeline
          and reconstructed continents. Explore individual finds, browse the dinosaur family tree,
          or play the daily Dinordle guessing game.
        </p>
        <figure class="project__figure">
          <a href="/dinosaurs" aria-label="See the Mesozoic Dinosaur Atlas project">
            <Image src={atlasShot} alt="Dinosaur fossil discoveries plotted on reconstructed continents, with a timeline set to about 72 million years ago." width={960} loading="lazy" />
          </a>
          <figcaption>Browse fossil discoveries by location and time.</figcaption>
        </figure>
        <div class="project__actions">
          <a href="/dinosaurs">See the project</a>
          <a href="https://paleomap.nelson-j.ch/" target="_blank" rel="noopener noreferrer">Explore the live atlas</a>
        </div>
      </article>

      <article class="project" id="formula-one-analysis">
        <div class="project__head">
          <h3><a href="/projects/formula-one-analysis">Formula 1 data analysis</a></h3>
          <span class="project__meta">Python · 2021 – 2024</span>
        </div>
        <p class="project__desc">
          I ran a race-analysis blog and built Python tooling to turn session and telemetry data
          into performance charts and reports. One example compares Ocon and Gasly's qualifying
          laps at the 2024 Australian Grand Prix to examine where their lap times diverged.
        </p>
        <figure class="project__figure">
          <a href="/projects/formula-one-analysis" aria-label="Read the Australia 2024 qualifying analysis sample">
            <Image src={qualifyingDelta} alt="Archived chart comparing the time difference between Ocon and Gasly over a qualifying lap at the 2024 Australian Grand Prix." width={960} loading="lazy" />
          </a>
          <figcaption>A chart from my March 2024 qualifying analysis.</figcaption>
        </figure>
        <div class="project__actions">
          <a href="/projects/formula-one-analysis">Read my qualifying analysis</a>
          <a href="https://github.com/Nelson-Jnrnd/F1_Telemetry_Charts" target="_blank" rel="noopener noreferrer">View my telemetry code</a>
        </div>
      </article>

      <article class="project" id="pit-stop-modelling">
        <div class="project__head">
          <h3><a href="/projects/pit-stop-modelling">Pit-stop decision modelling</a></h3>
          <span class="project__meta">B.Sc. thesis · 2023</span>
        </div>
        <p class="project__desc">
          For my bachelor's thesis, I collected and prepared Formula 1 race data, then compared
          random forests, neural networks and recurrent neural networks for predicting pit stops
          and tyre choices. I examined what drove their predictions and the limitations of
          learning from historical team decisions.
        </p>
        <figure class="project__figure">
          <a href="/projects/pit-stop-modelling" aria-label="Read the pit-stop decision modelling thesis summary">
            <img src="/projects/pit-stop-probabilities-stroll-2023.svg" alt="Thesis chart showing lap-by-lap predicted pit-stop probabilities for Lance Stroll in Spain 2023, with actual pit stops marked by red vertical lines." width="1067" height="480" loading="lazy" />
          </a>
          <figcaption>Predicted pit-stop probabilities compared with actual stops. A high predicted probability does not mean it was the best time to pit.</figcaption>
        </figure>
        <div class="project__actions">
          <a href="/projects/pit-stop-modelling">Read the thesis summary</a>
          <a href="https://github.com/Nelson-Jnrnd/f1-pit-predictor-report/blob/master/report.pdf" target="_blank" rel="noopener noreferrer">Read the public report (French PDF)</a>
        </div>
        <p class="project__note">My thesis was graded 5.6/6. The linked PDF is my intermediate report.</p>
      </article>
    </section>

    <!-- ───────────────── Toolkit ───────────────── -->
    <section class="section" id="toolkit" aria-label="Toolkit">
      <p class="kicker">Tools</p>
      <h2>How I build software</h2>
      <div class="tk">
        <div class="tk__row">
          <span class="tk__label">Languages</span>
          <span class="tk__items">
            <a class="ref" href={w("C_Sharp_(programming_language)")} target="_blank" rel="noopener noreferrer">C#</a>,
            <a class="ref" href={w("Java_(programming_language)")} target="_blank" rel="noopener noreferrer">Java</a>,
            <a class="ref" href={w("Python_(programming_language)")} target="_blank" rel="noopener noreferrer">Python</a>,
            <a class="ref" href={w("SQL")} target="_blank" rel="noopener noreferrer">SQL</a>,
            <a class="ref" href={w("JavaScript")} target="_blank" rel="noopener noreferrer">JavaScript</a>
          </span>
        </div>
        <div class="tk__row">
          <span class="tk__label">Frameworks</span>
          <span class="tk__items">
            <a class="ref" href={w("ASP.NET_Core")} target="_blank" rel="noopener noreferrer">ASP.NET Core</a>,
            <a class="ref" href={w("Blazor")} target="_blank" rel="noopener noreferrer">Blazor</a>,
            <a class="ref" href={w("Windows_Presentation_Foundation")} target="_blank" rel="noopener noreferrer">WPF</a>,
            <a class="ref" href={w("AngularJS")} target="_blank" rel="noopener noreferrer">AngularJS</a>,
            <a class="ref" href={w("Spring_Framework")} target="_blank" rel="noopener noreferrer">Spring</a>
          </span>
        </div>
        <div class="tk__row">
          <span class="tk__label">Infrastructure</span>
          <span class="tk__items">
            <a class="ref" href={w("Git")} target="_blank" rel="noopener noreferrer">Git</a>,
            <a class="ref" href={w("Docker_(software)")} target="_blank" rel="noopener noreferrer">Docker</a>,
            <a class="ref" href={w("Kubernetes")} target="_blank" rel="noopener noreferrer">Kubernetes</a>,
            <a class="ref" href={w("Google_Cloud_Platform")} target="_blank" rel="noopener noreferrer">GCP</a>,
            <a class="ref" href={w("Amazon_Web_Services")} target="_blank" rel="noopener noreferrer">AWS</a>,
            <a class="ref" href={w("Terraform_(software)")} target="_blank" rel="noopener noreferrer">Terraform</a>,
            <a class="ref" href={w("Ansible_(software)")} target="_blank" rel="noopener noreferrer">Ansible</a>,
            <a class="ref" href={w("CI/CD")} target="_blank" rel="noopener noreferrer">CI/CD</a>
          </span>
        </div>
        <div class="tk__row">
          <span class="tk__label">Data</span>
          <span class="tk__items">
            <a class="ref" href={w("Pandas_(software)")} target="_blank" rel="noopener noreferrer">Pandas</a>,
            <a class="ref" href={w("NumPy")} target="_blank" rel="noopener noreferrer">NumPy</a>,
            <a class="ref" href={w("Scikit-learn")} target="_blank" rel="noopener noreferrer">scikit-learn</a>,
            <a class="ref" href={w("TensorFlow")} target="_blank" rel="noopener noreferrer">TensorFlow</a>
          </span>
        </div>
      </div>
    </section>

    <!-- ───────────────── Interests ───────────────── -->
    <section class="section" id="interests" aria-label="Interests">
      <p class="kicker">Interests</p>
      <h2>What I do outside of work</h2>
      <p>
        Usually hanging out in the sun, playing tennis, watching racecars, and listening to music.
      </p>
      <div class="tags" aria-label="Interests">
        <a class="tag tag--ref" href={w("Motorsport")} target="_blank" rel="noopener noreferrer">Motorsport</a>
        <a class="tag tag--ref" href={w("Tennis")} target="_blank" rel="noopener noreferrer">Tennis</a>
        <a class="tag tag--ref" href={w("Board_game")} target="_blank" rel="noopener noreferrer">Board games</a>
        <a class="tag tag--ref" href={w("Magic:_The_Gathering")} target="_blank" rel="noopener noreferrer">Magic: The Gathering</a>
        <a class="tag tag--ref" href={w("Dungeons_%26_Dragons")} target="_blank" rel="noopener noreferrer">Dungeons &amp; Dragons</a>
        <span class="tag">Dinosaurs</span>
        <a class="tag tag--link" href="/music">Music ↗</a>
        <a class="tag tag--ref" href={w("Dog")} target="_blank" rel="noopener noreferrer">Dogs</a>
      </div>
    </section>

    <!-- ───────────────── Contact ───────────────── -->
    <section class="section" id="contact" aria-label="Contact">
      <p class="kicker">Contact</p>
      <h2>How to reach me</h2>
      <div class="links">
        <div class="link-row">
          <span class="link-row__key">Email</span>
          <span class="link-row__val"><a href={`mailto:${email}`}>{email}</a></span>
        </div>
        <div class="link-row">
          <span class="link-row__key">GitHub</span>
          <span class="link-row__val"><a href={github} target="_blank" rel="noopener noreferrer">github.com/nelson-jnrnd</a></span>
        </div>
        <div class="link-row">
          <span class="link-row__key">LinkedIn</span>
          <span class="link-row__val"><a href={linkedin} target="_blank" rel="noopener noreferrer">in/nelson-jeanrenaud</a></span>
        </div>
        <div class="link-row">
          <span class="link-row__key">CV</span>
          <span class="link-row__val"><a href={cv} download>Download (PDF)</a></span>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
