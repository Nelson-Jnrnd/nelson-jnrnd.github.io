---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const email = "nelsonjeanrenaud@gmail.com";
const github = "https://github.com/nelson-jnrnd";
const linkedin = "https://www.linkedin.com/in/nelson-jeanrenaud-b32374222";
const cv = "/cv/nelson-jeanrenaud-cv.pdf";
---

<BaseLayout>
  <SiteHeader />
  <span id="top"></span>

  <main class="wrap">
    <!-- ───────────────── Intro ───────────────── -->
    <section class="section intro" aria-label="Introduction">
      <div class="intro__top">
        <div class="intro__id">
          <h1>Nelson Jeanrenaud</h1>
          <p class="intro__role">
            software engineer <span class="sep">·</span> switzerland
          </p>
        </div>
        <img
          class="portrait"
          src="/images/portrait.jpg"
          alt="Nelson Jeanrenaud"
          width="104"
          height="104"
          loading="eager"
        />
      </div>

      <div class="intro__body">
        <p>
          I sit in front of a screen and read code. I used to write it; now I talk with
          people and LLMs.
        </p>
        <p class="lead">
          I still like systems that are useful and don't make the maintainer (usually future me)
          miserable.
        </p>
        <span class="status">
          <span class="status__dot" aria-hidden="true"></span>
          Open to work
        </span>
      </div>
    </section>

    <!-- ───────────────── Work ───────────────── -->
    <section class="section" id="work" aria-label="Work">
      <p class="kicker">Work</p>
      <h2>What I'm doing now</h2>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">HEIG-VD</span> · Institute of Industrial Automation · Yverdon-les-Bains</span>
          <span class="entry__date">Apr 2025 – Present</span>
        </div>
        <h3 class="entry__title">Software architect &amp; full-stack developer</h3>
        <p class="entry__desc">
          Right now I'm the software architect and full-stack dev on an agricultural automation
          R&amp;D project at HEIG-VD's Institute of Industrial Automation. The stack:
          <span class="accent-green">C# → ASP.NET Core → Blazor + WPF</span>.
        </p>
      </div>

      <h2 style="margin-top: 2.5rem;">Where I've been useful</h2>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">Swiss Armed Forces</span> · Maintenance School 43 · Thun</span>
          <span class="entry__date">Jul 2024 – Nov 2024</span>
        </div>
        <h3 class="entry__title">Communication diagnostician</h3>
        <p class="entry__desc">
          Basic military training and maintenance, plus diagnosis of military radio communication
          equipment.
        </p>
      </div>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">Abraxas Informatik AG</span> · Morges</span>
          <span class="entry__date">Aug 2023 – Oct 2024</span>
        </div>
        <h3 class="entry__title">Software developer</h3>
        <p class="entry__desc">
          Maintained and extended CARI, a large <span class="accent-green">Java</span> application used by Swiss road traffic offices.
          Mostly legacy code and the steady work of debugging, reviewing, refactoring, and improving
          things one PR at a time.
        </p>
      </div>

      <div class="entry">
        <div class="entry__head">
          <span class="entry__org"><span class="at">HEIG-VD</span> · Institute of Information &amp; Communication Technology · Yverdon-les-Bains</span>
          <span class="entry__date">Aug 2023 – Oct 2024</span>
        </div>
        <h3 class="entry__title">Teaching assistant</h3>
        <p class="entry__desc">
          Assisted both the OOP and Cloud Computing bachelor courses, helping students with
          object-oriented modelling (<span class="accent-green">Java</span>) and cloud topics
          (<span class="accent-green">AWS</span>/<span class="accent-green">GCP</span>,
          <span class="accent-green">Docker</span>, <span class="accent-green">Kubernetes</span>,
          <span class="accent-green">Terraform</span> and <span class="accent-green">Ansible</span>).
        </p>
      </div>
    </section>

    <!-- ───────────────── Projects ───────────────── -->
    <section class="section" id="projects" aria-label="Selected projects">
      <p class="kicker">Projects</p>
      <h2>What I've built for myself</h2>

      <div class="project">
        <div class="project__head">
          <h3>Formula 1 data analysis</h3>
          <span class="project__meta"><span class="accent-green">Python</span> · 2021 – 2024</span>
        </div>
        <p class="project__desc">
          Ran a blog where, each race weekend, I dove deep into the available data to find the how and
          why behind particular results, and to follow the improvements made to the cars across the
          season. For that I built tooling for telemetry and session analysis in
          <span class="accent-green">Python</span>, pulling race data and generating performance
          reports and charts.
        </p>
      </div>

      <div class="project">
        <div class="project__head">
          <h3>Pit-stop decision modelling</h3>
          <span class="project__meta">B.Sc. thesis · 2023</span>
        </div>
        <p class="project__desc">
          Machine learning for the call to pit in Formula 1: gathering and preparing data, then
          exploring models (<span class="accent-green">RF/NN/RNN</span>) to capture the relationship
          between race strategy and situation data, with a focus on explainability
          (<span class="accent-green">XAI</span>), digging into why the model says what it says.
          Graded 5.6/6.
        </p>
      </div>
    </section>

    <!-- ───────────────── Toolkit ───────────────── -->
    <section class="section" id="toolkit" aria-label="Toolkit">
      <p class="kicker">Tools</p>
      <h2>How I build without making future me hate me</h2>
      <div class="tk">
        <div class="tk__row">
          <span class="tk__label">Languages</span>
          <span class="tk__items">C#, Java, Python, SQL, JavaScript</span>
        </div>
        <div class="tk__row">
          <span class="tk__label">Frameworks</span>
          <span class="tk__items">ASP.NET Core, Blazor, WPF, AngularJS, Spring</span>
        </div>
        <div class="tk__row">
          <span class="tk__label">Infrastructure</span>
          <span class="tk__items">Git, Docker, Kubernetes, GCP, AWS, Terraform, Ansible, CI/CD</span>
        </div>
        <div class="tk__row">
          <span class="tk__label">Data</span>
          <span class="tk__items">Pandas, NumPy, scikit-learn, TensorFlow</span>
        </div>
      </div>
    </section>

    <!-- ───────────────── Interests ───────────────── -->
    <section class="section" id="interests" aria-label="Interests">
      <p class="kicker">Interests</p>
      <h2>What I do outside of work</h2>
      <p>
        Usually hanging out in the sun, playing tennis, watching racecars, and listening to music.
      </p>
      <div class="tags" aria-label="Interests">
        <span class="tag">Motorsport</span>
        <span class="tag">Tennis</span>
        <span class="tag">Board games</span>
        <span class="tag">Magic: The Gathering</span>
        <span class="tag">Dungeons &amp; Dragons</span>
        <span class="tag">Dinosaurs</span>
        <span class="tag">Music</span>
        <span class="tag">Dogs</span>
      </div>
    </section>

    <!-- ───────────────── Contact ───────────────── -->
    <section class="section" id="contact" aria-label="Contact">
      <p class="kicker">Contact</p>
      <h2>How to reach me</h2>
      <div class="links">
        <div class="link-row">
          <span class="link-row__key">Email</span>
          <span class="link-row__val"><a href={`mailto:${email}`}>{email}</a></span>
        </div>
        <div class="link-row">
          <span class="link-row__key">GitHub</span>
          <span class="link-row__val"><a href={github} target="_blank" rel="noopener noreferrer">github.com/nelson-jnrnd</a></span>
        </div>
        <div class="link-row">
          <span class="link-row__key">LinkedIn</span>
          <span class="link-row__val"><a href={linkedin} target="_blank" rel="noopener noreferrer">in/nelson-jeanrenaud</a></span>
        </div>
        <div class="link-row">
          <span class="link-row__key">CV</span>
          <span class="link-row__val"><a href={cv} download>Download (PDF)</a></span>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
